# Environment for the local background worker
# copied to .env.worker by just setup
# In production, set the same keys with real values"

DJANGO_SETTINGS_MODULE=config.settings.worker
DJANGO_SECRET_KEY=django-insecure-local-worker-key

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=wies
POSTGRES_PASSWORD=wies
POSTGRES_DB=wies

# Worker runs OTYS sync tasks
OTYS_API_KEY=XXXXXXX
OTYS_URL=https://XXXXXXXX.com

# Knowledge base publish task (kb_publish): object-store write access + a GitHub
# read token for the private content repo's release artifacts. Optional — the
# worker boots without them and only the kb_publish task fails (with a clear
# message) if they're unset. Fill them to exercise publishing locally. ZAD injects
# the OBJECT_STORE_* names in production; the endpoint is composed from host+port.
OBJECT_STORE_HOST=minio
OBJECT_STORE_PORT=9000
OBJECT_STORE_USER=XXXXXXX
OBJECT_STORE_PASSWORD=XXXXXXX
OBJECT_STORE_BUCKET_NAME=wies-kb
KB_CONTENT_GITHUB_REPO=rubenrouwhof/odi-startpagina
# KB_CONTENT_GITHUB_TOKEN=XXXXXXX  # uncomment and set when repo is private
