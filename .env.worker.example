# Environment for the local background worker
# copied to .env.worker by just setup
# In production, set the same keys with real values"

DJANGO_SETTINGS_MODULE=config.settings.worker
DJANGO_SECRET_KEY=django-insecure-local-worker-key

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=wies
POSTGRES_PASSWORD=wies
POSTGRES_DB=wies

# Worker runs OTYS sync tasks
OTYS_API_KEY=XXXXXXX
OTYS_URL=https://XXXXXXXX.com

# Knowledge base publish task (kb_publish): object-store write access. Optional —
# the worker boots without them and only the kb_publish task fails (with a clear
# message) if they're unset. ZAD injects the OBJECT_STORE_* names in production;
# the endpoint is composed from host+port. Locally docker-compose.yml sets them,
# so these are for running the worker outside compose.
OBJECT_STORE_HOST=minio
OBJECT_STORE_PORT=9000
OBJECT_STORE_USER=XXXXXXX
OBJECT_STORE_PASSWORD=XXXXXXX
OBJECT_STORE_BUCKET_NAME=wies-kb

# Knowledge base content repo (private): kb_publish needs a fine-grained
# token with Contents: read on it. Without one the publish task gets a 401.
KB_CONTENT_GITHUB_REPO=DigiGilde/odi-startpagina
KB_CONTENT_GITHUB_TOKEN=XXXXX
