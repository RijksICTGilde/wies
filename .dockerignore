# The Dockerfile copies by name (manage.py, docker-entrypoint.sh, config,
# wies), so this file does not decide what ends up in the image. It does
# two other things.

# 1. Filter inside the directories that are copied
**/tests
**/__pycache__
*.py[cod]

# 2. Keep secrets and bulk out of the build context
.env
.env.*
.git
.venv
node_modules
staticfiles
db
.cache
